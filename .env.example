VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only. Never prefixed with VITE_, never sent to the browser. ---
#
# There is deliberately no SUPABASE_SERVICE_ROLE_KEY here any more. The catalog
# is written by the scraper agent (docs/scraper-agent-prompt.md), which holds
# that key in its own environment; nothing in this repo needs it.

# Edge function secrets. Set these with `supabase secrets set KEY=value`,
# NOT here — this file is only read by local scripts.
# Use a restricted key (rk_...) scoped to Checkout, Billing and Customers
# rather than a full secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
